# --- Map generation definitions ---
map_definitions <- list(
  list(
    type = "occurrence",
    overlays = list(
      list(name = "Botanic garden", data = bg_points_buf, color = "purple", file = "map03_occ_density_bg_pts_20km"),
      list(name = "Genebank Points", data = gb_points_buf, color = "goldenrod", file = "map04_occ_density_gb_pts_20km"),
      list(
        name = c("Botanic garden", "Genebank Points"),
        data = list(bg_points_buf, gb_points_buf),
        color = c("purple", "goldenrod"),
        file = "map05_occ_density_bg_gb_pts_20km"
      )
    ),
    fill_aes = aes(fill = count),
    fill_title = "Occurrences",
    fill_var = "count",
    grid_data = grid_land_proj,
    title = "Global occurrence density, 20km"
  ),
  list(
    type = "richness",
    overlays = list(
      list(name = "Botanic garden", data = bg_points_buf, color = "purple", file = "map06_species_richness_bg_pts_20km"),
      list(name = "Genebank Points", data = gb_points_buf, color = "goldenrod", file = "map07_species_richness_gb_pts_20km"),
      list(
        name = c("Botanic garden", "Genebank Points"),
        data = list(bg_points_buf, gb_points_buf),
        color = c("purple", "goldenrod"),
        file = "map08_species_richness_bg_gb_pts_20km"
      )
    ),
    fill_aes = aes(fill = richness),
    fill_title = "Richness",
    fill_var = "richness",
    grid_data = grid_richness_land_proj,
    title = "Global species richness, 20km"
  )
)

for (map_def in map_definitions) {
  for (overlay in map_def$overlays) {
    p <- ggplot() +
      geom_sf(data = world_plot, fill = "grey98", color = NA) +
      geom_sf(data = map_def$grid_data, mapping = map_def$fill_aes, color = NA) +
      geom_sf(data = world_plot, fill = NA, color = "grey80", size = 0.2)

    # Overlay logic
    if (is.list(overlay$data) && length(overlay$data) == 2) {
      p <- p +
        geom_sf(data = overlay$data[[1]], aes(color = overlay$name[1]), size = pt_size, alpha = 0.4, show.legend = "point") +
        geom_sf(data = overlay$data[[2]], aes(color = overlay$name[2]), size = pt_size, alpha = 0.4, show.legend = "point") +
        scale_color_manual(
          name = "Overlay Points",
          values = setNames(overlay$color, overlay$name),
          guide = guide_legend(override.aes = list(size = 3, alpha = 1))
        )
    } else {
      p <- p +
        geom_sf(data = overlay$data, aes(color = overlay$name), size = pt_size, alpha = 0.4, show.legend = "point") +
        scale_color_manual(
          name = "Overlay Points",
          values = setNames(overlay$color, overlay$name),
          guide = guide_legend(override.aes = list(size = 3, alpha = 1))
        )
    }
    p <- p +
      scale_fill_gradient(
        low = "lightgreen", high = "darkgreen", trans = "log10", na.value = "white",
        name = map_def$fill_title
      ) +
      labs(
        title = paste0(map_def$title, if (length(overlay$name) == 2) " (BG & Genebanks, buffer 10km)" else
          sprintf(" (%s, buffer 10km)", overlay$name[1])),
        fill = map_def$fill_title
      ) +
      theme_minimal() +
      theme(panel.background = element_rect(fill = "white", color = NA))
    save_map_both(p, overlay$file, output_dir)
    cat(sprintf("Saved: %s.[pdf|png]\n", overlay$file))
  }
}








