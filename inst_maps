# --- 5. Prepare gridded layers or other overlays ---

library(sf)
library(dplyr)

cell_size <- 20000 # 20km grid cells

# 1. Project occurrence points to equal area
occurrences_proj <- st_transform(occurrences_land, crs = crs_equalarea)

# 2. Create a 20km global grid covering all points
grid <- st_make_grid(occurrences_proj, cellsize = c(cell_size, cell_size), what = "polygons")

# 3. Convert grid to sf for joining
grid_sf <- st_sf(grid_id = 1:length(grid), geometry = grid)

# 4. Assign each occurrence point to a grid cell
point_grid_join <- st_join(occurrences_proj, grid_sf, left = FALSE)

# 5. Calculate occurrence density per cell
density_table <- point_grid_join %>%
  st_drop_geometry() %>%
  group_by(grid_id) %>%
  tally(name = "count")

# 6. Calculate species richness per cell
richness_table <- point_grid_join %>%
  st_drop_geometry() %>%
  group_by(grid_id) %>%
  summarise(richness = n_distinct(genus_species))

# 7. Attach density and richness to grid
grid_with_counts <- left_join(grid_sf, density_table, by = "grid_id")
grid_with_counts$count[is.na(grid_with_counts$count)] <- 0

grid_with_richness <- left_join(grid_sf, richness_table, by = "grid_id")
grid_with_richness$richness[is.na(grid_with_richness$richness)] <- 0

# 8. (Recommended) Mask grid to land only (using your projected world polygon)
world <- ne_countries(scale = "medium", returnclass = "sf") %>% filter(admin != "Antarctica")
world_proj <- st_transform(world, crs_equalarea)

grid_land <- st_filter(grid_with_counts, world_proj)
grid_richness_land <- st_filter(grid_with_richness, world_proj)

# 9. (Optional) Reproject grid to ensure exact match with plotting CRS
grid_land_proj <- st_transform(grid_land, crs_equalarea)
grid_richness_land_proj <- st_transform(grid_richness_land, crs_equalarea)

# --- Set zeros to NA for mapping so log10 scale does not produce -Inf ---
grid_land_proj$plot_count <- grid_land_proj$count
grid_land_proj$plot_count[grid_land_proj$plot_count == 0] <- NA

grid_richness_land_proj$plot_richness <- grid_richness_land_proj$richness
grid_richness_land_proj$plot_richness[grid_richness_land_proj$plot_richness == 0] <- NA

