  mutate(genus_species_WFO = str_trim(str_to_lower(genus_species_WFO))) %>%
  select(genus_species_WFO, taxon_name_accepted) %>%
  filter(!is.na(genus_species_WFO) & genus_species_WFO != "") %>%
  distinct(genus_species_WFO, .keep_all = TRUE)

# 3. Annotate function
add_plant_list_origin <- function(df) {
  df <- df %>%
    mutate(genus_species = str_trim(str_to_lower(genus_species)))
  # 3a. Primary match on genus_species
  df1 <- df %>%
    left_join(ref_gs, by = "genus_species")
  # 3b. For NA matches, try genus_species_WFO
  idx_na <- which(is.na(df1$taxon_name_accepted) & !is.na(df1$genus_species) & df1$genus_species != "")
  if(length(idx_na) > 0) {
    df2 <- df1[idx_na, ] %>%
      select(-taxon_name_accepted) %>%
      left_join(ref_wfo, by = c("genus_species" = "genus_species_WFO"))
    df1$plant_list_origin <- df1$taxon_name_accepted
    df1$plant_list_origin[idx_na] <- df2$taxon_name_accepted
  } else {
    df1$plant_list_origin <- df1$taxon_name_accepted
  }
  df1 <- df1 %>% select(-taxon_name_accepted)
  return(df1)
}

