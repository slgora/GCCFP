library(iucnredlist)
library(dplyr)
library(tibble)
library(purrr)
library(readr)
library(tidyr)

# Initialize your API
api <- init_api("MY-API-TOKEN-HERE")

# Read the species list
veg_list1 <- read_csv("Agrobio_veg_list/Standardized_veg_lists/Vegetable_species_list_1450_2_standardized_2025_09_11.csv")

# Make genus and species fields from WFO standardized name
veg_list1 <- veg_list1 %>%
  separate(taxon_standardized_WFO, into = c("genus_WFO", "species_WFO"), sep = " ", remove = FALSE)

# Extract the species
species_list <- veg_list1 %>% select(genus = genus_WFO, species = species_WFO)

# Helper for NA fallback
`%||%` <- function(a, b) if (!is.null(a)) a else b

failed_taxa <- character(0) # Empty character vector

extract_redlist_fields <- function(api, genus, species) {
  `%||%` <- function(a, b) if (!is.null(a)) a else b
  safe_collapse <- function(x) {
    if (is.null(x)) return(NA_character_)
    if (length(x) == 0) return(NA_character_)
    if (is.list(x) && !is.data.frame(x)) x <- unlist(x)
    paste(x, collapse = "; ")
  }
  tryCatch({
    assessments <- assessments_by_name(api, genus = genus, species = species)
    if (nrow(assessments) == 0) {
      failed_taxa <<- c(failed_taxa, paste(genus, species))
      return(NULL)
    }
    # Use the most recent assessment (latest==TRUE or first row)
    ix <- which(assessments$latest == TRUE)
    if(length(ix) == 0) ix <- 1
    assessment_id <- assessments$assessment_id[ix][1]
    scientificName <- assessments$taxon_scientific_name[ix][1] %||% paste(genus, species)
    redlistCategory <- assessments$red_list_category_code[ix][1] %||% NA_character_
    yearPublished <- assessments$year_published[ix][1] %||% NA_character_
    scopes <- assessments$scopes_description_en[ix][1] %||% NA_character_
    possiblyExtinct <- as.character(assessments$possibly_extinct[ix][1])
    possiblyExtinctInTheWild <- as.character(assessments$possibly_extinct_in_the_wild[ix][1])
    url <- assessments$url[ix][1] %||% NA_character_
    sis_taxon_id <- as.character(assessments$sis_taxon_id[ix][1])

    # Detailed assessment for deep fields
    raw <- assessment_data(api, assessment_id)
    parsed <- parse_assessment_data(raw)

    tibble::tibble(
      assessmentId = as.character(assessment_id),
      sisTaxonId = sis_taxon_id,
      scientificName = scientificName,
      redlistCategory = redlistCategory,
      yearPublished = yearPublished,
      assessmentDate = safe_collapse(parsed$assessment_date),
      criteriaVersion = safe_collapse(parsed$criteria_version),
      language = safe_collapse(parsed$language),
      rationale = safe_collapse(parsed$rationale),
      habitat = if(!is.null(parsed$habitats)) safe_collapse(parsed$habitats$description) else NA_character_,
      threats = if(!is.null(parsed$threats)) safe_collapse(parsed$threats$description) else NA_character_,
      population = safe_collapse(parsed$population),
      populationTrend = safe_collapse(parsed$population_trend),
      range = safe_collapse(parsed$range),
      useTrade = safe_collapse(parsed$use_trade),
      systems = safe_collapse(parsed$systems),
      conservationActions = safe_collapse(parsed$conservation_actions),
      realm = safe_collapse(parsed$realm),
      yearLastSeen = safe_collapse(parsed$year_last_seen),
      possiblyExtinct = possiblyExtinct,
      possiblyExtinctInTheWild = possiblyExtinctInTheWild,
      scopes = scopes,
      url = url
    )
  }, error = function(e) {
    failed_taxa <<- c(failed_taxa, paste(genus, species))
    return(NULL)
  })
}

# Run extraction
redlist_results <- pmap_dfr(species_list, ~extract_redlist_fields(api, ..1, ..2))

# Show failed taxa
cat("Failed taxa:\n")
print(failed_taxa)

# View or write to CSV
View(redlist_results)
write.csv(redlist_results, "veg_list1_iucn_redlist_extracted.csv", row.names = FALSE)
write.csv(redlist_results, "veg_list1_iucn_redlist_FAILED_TAXA.csv", row.names = FALSE)




