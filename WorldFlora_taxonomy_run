# ---- WorldFlora Full Updated Workflow ----

library(dplyr)
library(tidyr)
library(WorldFlora)


# 1. Read your downloaded CSV backbone (edit path if needed)
wfo_csv <- read.csv("C:/Users/sarah/Documents/GCCFP/classification.csv", stringsAsFactors = FALSE)

# 2. Write as tab-delimited TXT for WorldFlora
write.table(
  wfo_csv,
  file = "C:/Users/sarah/Documents/GCCFP/classification.txt",
  sep = "\t",
  row.names = FALSE,
  quote = FALSE
)

# 3. Restart R session (RStudio: Session > Restart R), then re-run from here:

# 4. Load WorldFlora and register the backbone
library(WorldFlora)
WFO.remember("C:/Users/sarah/Documents/GCCFP/classification.txt", quote = "")

# 5. Read your plant list from CSV, extracting the 'Taxon' column
cwr_veg_list <- read_csv("C:/Users/sarah/Downloads/CWR genepools for veg list 07 July 2025_SG.csv")
plant_names1 <- cwr_veg_list$Taxon

# 6. Run WFO.match, ALWAYS providing WFO.file
results1 <- WFO.match(
  plant_names1,
  WFO.file = "C:/Users/sarah/Documents/GCCFP/classification.txt"
)

# 7. Inspect results
View(results1)

# Save taxon table results to CSV
write.csv(results1, "C:/Users/sarah/Documents/GCCFP/Taxon_standardization/cwr_veg_list_taxon_table2025_09_11.csv", row.names = FALSE)



# 1. Save the WorldFlora results as cwr_veg_list_taxon_table
cwr_veg_list_taxon_table <- results1

# 2. For each original Taxon, find the best standardized name
# If you want the 'Accepted' scientific name for each input:

# Get best match per input, prioritizing Matched == TRUE and Accepted status
best_matches <- cwr_veg_list_taxon_table %>%
  filter(Matched) %>%
  group_by(spec.name.ORIG) %>%
  # Prefer 'Accepted' taxonomicStatus, fallback to first if not found
  arrange(factor(taxonomicStatus, levels = c("Accepted", "Unchecked", "Synonym")), .by_group = TRUE) %>%
  slice(1) %>%
  ungroup() %>%
  select(spec.name.ORIG, standardized_taxon = scientificName)

# 3. Merge standardized name back to your original table
cwr_veg_list_standardized <- cwr_veg_list %>%
  left_join(best_matches, by = c("Taxon" = "spec.name.ORIG"))

# 4. Save to CSV with today's date
write.csv(
  cwr_veg_list_standardized,
  "C:/Users/sarah/Documents/GCCFP/Taxon_standardization/CWR_genepools_for_veg_list_standardized_WFO2025_09_11.csv",
  row.names = FALSE
)



