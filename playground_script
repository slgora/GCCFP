# Playground script: Visualizing Genebank Overlay Map with Varying Point Size and Buffer

# --- Libraries ---
library(dplyr)
library(ggplot2)
library(sf)
library(rnaturalearth)
library(readxl)
library(readr)
library(stringr)

# --- Parameters ---
output_dir <- "maps/playground"
if (!dir.exists(output_dir)) dir.create(output_dir, recursive = TRUE)

sz <- "20km"
cell_size <- 20000 # meters

# --- Prepare data (standalone, using your workflow structure) ---

data_root <- "G:/.shortcut-targets-by-id/1kQBvFIumhKQHnxSXNhr7w70dvuHgheEO/GCCFP/Data and analyses/"

# 1. World polygons (exclude Antarctica)
world <- ne_countries(scale = "medium", returnclass = "sf") %>%
  filter(admin != "Antarctica")
world_4326 <- st_transform(world, 4326)

# 2. Occurrences data (Genebank, Botanic Garden, GBIF)
gbif_observations <- read_csv(
  file.path(data_root, "Food plant distributions/GBIF_geo_data/WCFP_GBIF_observations_2025-08-27.csv")
) %>%
  select(latitude, longitude, genus_species) %>%
  mutate(
    data_source = "GBIF observations",
    inst_type = "Botanic garden"
  )

genebank_accessionlevel_dataset <- read_csv(
  file.path(data_root, "Complementarity analysis/Data_processed/Datasets_processed/WCFP_genebank_accessionlevel_dataset_2025-08-26.csv")
)

WCFP_Genesys_data_all <- read.csv("Data/colin_dataset_from_Christelle_2025-03-25.csv", sep = ";") %>%
  mutate(data_source = "Genesys")

genebank_accessionlevel_with_coords <- genebank_accessionlevel_dataset %>%
  left_join(
    WCFP_Genesys_data_all %>%
      select(UUID, DECLATITUDE, DECLONGITUDE),
    by = c("uuid" = "UUID")
  ) %>%
  select(-latitude, -longitude) %>%
  rename(
    latitude = DECLATITUDE,
    longitude = DECLONGITUDE
  ) %>%
  mutate(
    latitude = as.numeric(str_replace(latitude, ",", ".")),
    longitude = as.numeric(str_replace(longitude, ",", "."))
  )
genebank_accessionlevel_dataset_selected <- genebank_accessionlevel_with_coords %>%
  select(genus_species, latitude, longitude, data_source, inst_type)

botanicgarden_accessionlevel_dataset <- read_csv(
  file.path(data_root, "Complementarity analysis/Data_processed/Datasets_processed/WCFP_botanicgarden_accessionlevel_dataset_2025-08-27.csv")
)
botanicgarden_accessionlevel_with_coords <- botanicgarden_accessionlevel_dataset %>%
  left_join(
    WCFP_Genesys_data_all %>%
      select(UUID, DECLATITUDE, DECLONGITUDE),
    by = c("uuid" = "UUID")
  ) %>%
  mutate(
    latitude = if_else(
      data_source == "Genesys",
      as.numeric(str_replace(DECLATITUDE, ",", ".")),
      latitude
    ),
    longitude = if_else(
      data_source == "Genesys",
      as.numeric(str_replace(DECLONGITUDE, ",", ".")),
      longitude
    )
  ) %>%
  select(-DECLATITUDE, -DECLONGITUDE)
botanicgarden_accessionlevel_dataset_selected <- botanicgarden_accessionlevel_with_coords %>%
  select(genus_species, latitude, longitude, data_source, inst_type)

botanicgarden_specieslevel_dataset_selected <- read_csv(
  file.path(data_root, "Complementarity analysis/Data_processed/Datasets_processed/WCFP_botanicgarden_specieslevel_dataset_2025-08-26.csv")
) %>%
  select(genus_species, latitude, longitude, data_source, inst_type)

occurrences_data <- bind_rows(
  gbif_observations,
  genebank_accessionlevel_dataset_selected,
  botanicgarden_accessionlevel_dataset_selected,
  botanicgarden_specieslevel_dataset_selected
) %>%
  filter(!is.na(latitude), !is.na(longitude)) %>%
  filter(between(latitude, -90, 90), between(longitude, -180, 180))

# 3. Convert to sf and filter to land only
occurrences_sf <- st_as_sf(
  occurrences_data,
  coords = c("longitude", "latitude"),
  crs = 4326, remove = FALSE
)
occurrences_land <- st_join(occurrences_sf, world_4326, join = st_within, left = FALSE)

# 4. Make grid (20km) and grid_with_counts
crs_equalarea <- 8857 # Equal Earth CRS
occurrences_proj <- st_transform(occurrences_land, crs = crs_equalarea)
grid <- st_make_grid(occurrences_proj, cellsize = c(cell_size, cell_size), what = "polygons")
grid_sf <- st_sf(grid_id = 1:length(grid), geometry = grid)
point_grid_join <- st_join(occurrences_proj, grid_sf, left = FALSE)
density_table <- point_grid_join %>%
  st_drop_geometry() %>%
  group_by(grid_id) %>%
  tally(name = "count")
grid_with_counts <- left_join(grid_sf, density_table, by = "grid_id")
grid_with_counts$count[is.na(grid_with_counts$count)] <- 0

# --- Only Genebank points
gb_points <- occurrences_land %>% filter(inst_type == "Genebank")

# Project world and grid for plotting
world_plot <- st_transform(world_4326, crs = crs_equalarea)
grid_land <- st_transform(grid_with_counts, crs = crs_equalarea)
gb_points_proj <- st_transform(gb_points, crs = crs_equalarea)

# --- Experiment settings ---
# pt_sizes <- c(0.01, 0.005, 0.002)

# use this pt size
pt_sizes <- c(0.002)

# buffer_sizes <- c(NA, cell_size, cell_size / 2) # NA = no buffer, cell_size = same as grid, smaller buffer

# use this buffer size
buffer_sizes <- c(cell_size / 2)


# --- Helper for label
label_buffer <- function(b) {
  if (is.na(b)) "nobuffer"
  else if (b == cell_size) "buffer_eq_grid"
  else "buffer_half_grid"
}

# --- Run all combinations ---
for (pt_size in pt_sizes) {
  for (buf in buffer_sizes) {
    # Buffer points if requested
    if (is.na(buf)) {
      gb_pts_disp <- gb_points_proj
    } else {
      gb_pts_disp <- st_buffer(gb_points_proj, dist = buf)
    }

    # Plot
    map_gb <- ggplot() +
      geom_sf(data = world_plot, fill = "grey98", color = NA) + # land base
      geom_sf(data = grid_land %>% filter(count > 0), aes(fill = count), color = NA) + # only nonzero grid cells
      geom_sf(data = world_plot, fill = NA, color = "grey80", size = 0.2) + # borders
      geom_sf(
        data = gb_pts_disp,
        aes(color = "Genebank Points"),
        size = pt_size, alpha = 0.4, show.legend = "point"
      ) +
      scale_fill_gradient(
        low = "lightgreen", high = "darkgreen", trans = "log10",
        name = sprintf("Occurrences (%s)", sz),
        na.value = "white"
      ) +
      scale_color_manual(
        name = "Overlay Points",
        values = c("Genebank Points" = "goldenrod"),
        guide = guide_legend(override.aes = list(size = 3, alpha = 1))
      ) +
      labs(
        title = sprintf("Genebank overlay: pt size %.3f, %s", pt_size, label_buffer(buf)),
        fill = "Occurrences"
      ) +
      theme_minimal() +
      theme(panel.background = element_rect(fill = "white", color = NA))

    # Save
    fname_base <- sprintf("play_map_gb_pts_%s_pt%.3f_%s", sz, pt_size, label_buffer(buf))
    ggsave(file.path(output_dir, paste0(fname_base, ".pdf")), plot = map_gb, width = 14, height = 7, units = "in", device = cairo_pdf, bg = "white")
    ggsave(file.path(output_dir, paste0(fname_base, ".png")), plot = map_gb, width = 14, height = 7, units = "in", dpi = 300, bg = "white")
    print(sprintf("Saved: %s.[pdf|png]", fname_base))
  }
}
