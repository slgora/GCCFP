######## Species-level Pie Chart of Food Plant Species Conserved ex situ ########

# 1. Load required libraries
library(ggplot2)
library(dplyr)

# 2. Manually define the species counts for each category
species_counts <- data.frame(
  Category = c("Genebanks only", "Botanic Gardens only", "Both", "Neither"),
  Count = c(378, 10858, 7844, 5978)
) %>%
  mutate(Label = paste0(Category, " (", Count, ")"))

# 3. Define a color palette for the categories
colors <- c(
  "Genebanks only" = "#1f77b4",       # Blue
  "Botanic Gardens only" = "#2ca02c", # Green
  "Both" = "#17becf",                 # Teal blend
  "Neither" = "#7f7f7f"               # Gray
)

# 4. Generate the pie chart
ggplot(species_counts, aes(x = "", y = Count, fill = Category)) +
  geom_bar(stat = "identity", width = 1, color = "white") +
  coord_polar("y", start = 0) +
  scale_fill_manual(values = colors) +
  theme_void() +
  labs(title = expression("Number of Distinct Food Plant Species Conserved "*italic("ex situ"))) +
  theme(
    plot.title = element_text(hjust = 0.5, size = 16, face = "bold"),
    legend.title = element_blank(),
    legend.text = element_text(size = 12)
  ) +
  geom_text(
    aes(label = Label),
    position = position_stack(vjust = 0.5),
    size = 5,
    fontface = "bold",
    color = "gray10"
  )









