library(dplyr)
library(ggplot2)

# Define bins and labels (adjust if you want even more/less resolution)
bin_breaks <- c(0, 10, 50, 100, 1000, 10000, 100000, 1e6, Inf)
bin_labels <- c("1-10", "11-50", "51-100", "101-1,000", "1,001-10,000",
                "10,001-100,000", "100,001-1,000,000", "1,000,001+")

# Function to process dataset
species_bin_counts <- function(df, repo_label) {
  df %>%
    group_by(plant_list_origin) %>%   # Count accessions per species
    summarise(accession_count = n(), .groups = "drop") %>%
    mutate(bin = cut(accession_count, breaks = bin_breaks, labels = bin_labels, right = TRUE)) %>%
    group_by(bin) %>%
    summarise(species_count = n(), .groups = "drop") %>%
    mutate(Repository = repo_label)
}

# Process genebank and botanic garden datasets
