# Bar Chart: Number of distinct institutions per food plant species
# Chart 1: Top N species with the most institutions (per repository type)
# Enhancements:
# - Capitalize first word of species
# - Italicize species labels
# - Add institution counts above bars
################################################################################

library(readr)
library(dplyr)
library(ggplot2)
library(stringr)

# 1. Read in processed data:
genebank_accessionlevel_dataset <- read_csv("G:/.shortcut-targets-by-id/1kQBvFIumhKQHnxSXNhr7w70dvuHgheEO/GCCFP/Data and analyses/Complementarity analysis/Data_processed/Datasets_processed/WCFP_genebank_accessionlevel_dataset_2025-09-16.csv")
botanicgarden_accessionlevel_dataset <- read_csv("G:/.shortcut-targets-by-id/1kQBvFIumhKQHnxSXNhr7w70dvuHgheEO/GCCFP/Data and analyses/Complementarity analysis/Data_processed/Datasets_processed/WCFP_botanicgarden_accessionlevel_dataset_2025-09-16.csv")

# 2. Calculate the number of distinct institutions per species for each repository
genebank_inst <- genebank_accessionlevel_dataset %>%
  group_by(plant_list_origin) %>%
  summarise(n_inst = n_distinct(inst_code), .groups = "drop") %>%
  mutate(inst_type = "Genebank")

bg_inst <- botanicgarden_accessionlevel_dataset %>%
  group_by(plant_list_origin) %>%
  summarise(n_inst = n_distinct(inst_code), .groups = "drop") %>%
  mutate(inst_type = "Botanic Garden")

# 3. Combine for plotting
inst_per_species <- bind_rows(genebank_inst, bg_inst)

# 4. Select top N species by number of institutions for each repository type
top_n <- 20

top_species <- inst_per_species %>%
  group_by(inst_type) %>%
  slice_max(order_by = n_inst, n = top_n, with_ties = FALSE) %>%
  ungroup()

# 5. Capitalize first word and create italicized species labels
top_species <- top_species %>%
  mutate(
    plant_list_origin_cap = str_replace(plant_list_origin, "^[a-zA-Z]+", function(x) str_to_title(x)),
    Species_label = paste0("italic('", plant_list_origin_cap, "')")
  )

# 6. Set color palette
colors <- c("Genebank" = "#1f77b4", "Botanic Garden" = "#2ca02c")

# 7. Plot: Top N species by institutions, with counts and italics
plot1 <- ggplot(top_species, aes(x = reorder(plant_list_origin, n_inst), y = n_inst, fill = inst_type)) +
  geom_bar(stat = "identity", position = position_dodge(width = 0.8)) +
  geom_text(aes(label = n_inst), position = position_dodge(width = 0.8), hjust = -0.1, size = 4) +
  coord_flip() +
  scale_fill_manual(values = colors) +
  labs(
    title = paste("Top", top_n, "Species by Number of Distinct Institutions"),
    x = "Species",
    y = "# of Institutions",
    fill = ""
  ) +
  scale_x_discrete(
    labels = parse(text = top_species$Species_label[order(top_species$n_inst)])
  ) +
  theme_minimal(base_size = 14) +
  theme(
    plot.title = element_text(hjust = 0.5, face = "bold"),
    legend.position = "top"
  )

print(plot1)






